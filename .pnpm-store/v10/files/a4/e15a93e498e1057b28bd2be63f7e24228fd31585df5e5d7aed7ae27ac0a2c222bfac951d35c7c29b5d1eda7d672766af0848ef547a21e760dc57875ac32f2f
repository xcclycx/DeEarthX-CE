<svg width="1024" height="1024" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0F172B"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </linearGradient>
    <linearGradient id="arrow" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#f43f5e"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>
    <radialGradient id="glow" cx="0.5" cy="0.3" r="0.6">
      <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#f43f5e" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- 圆角背景 -->
  <rect width="1024" height="1024" rx="220" ry="220" fill="url(#bg)"/>
  <rect width="1024" height="1024" rx="220" ry="220" fill="url(#glow)"/>

  <!-- 安装盒外框 -->
  <rect x="220" y="380" width="584" height="380" rx="40" ry="40"
        fill="none" stroke="#ffffff" stroke-opacity="0.15" stroke-width="14"/>

  <!-- 下载箭头 -->
  <g transform="translate(512 480)">
    <rect x="-50" y="-260" width="100" height="380" rx="20" ry="20" fill="url(#arrow)"/>
    <polygon points="-150,80 150,80 0,260" fill="url(#arrow)"/>
  </g>

  <!-- 闪烁星点 -->
  <circle cx="220" cy="240" r="14" fill="#f43f5e"/>
  <circle cx="780" cy="180" r="10" fill="#06b6d4"/>
  <circle cx="860" cy="320" r="8" fill="#10b981"/>
  <circle cx="180" cy="780" r="10" fill="#06b6d4"/>
  <circle cx="840" cy="820" r="12" fill="#f43f5e"/>
</svg>
