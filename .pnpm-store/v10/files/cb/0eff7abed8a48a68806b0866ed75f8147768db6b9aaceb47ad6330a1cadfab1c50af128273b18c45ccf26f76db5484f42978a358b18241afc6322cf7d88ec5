/* Hologram 3D 全息科幻投影风格 */

@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

.holo-root {
  --holo-cyan: #00f3ff;
  --holo-magenta: #ff00ea;
  --holo-bg: rgba(0, 15, 20, 0.85);
  
  font-family: 'Orbitron', sans-serif;
  background: transparent;
  color: var(--holo-cyan);
  -webkit-font-smoothing: antialiased;
  /* 为 3D 旋转提供透视视口 */
  perspective: 1200px;
}

.holo-projector {
  width: 700px;
  height: 540px;
  background: var(--holo-bg);
  border: 1px solid rgba(0, 243, 255, 0.3);
  box-shadow: 
    0 0 20px rgba(0, 243, 255, 0.2), 
    inset 0 0 50px rgba(0, 243, 255, 0.1);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  /* 静态的轻微 3D 倾斜效果，增强全息感 */
  transform: rotateX(2deg) rotateY(-2deg);
  transform-style: preserve-3d;
}

/* 全息背景网格 */
.holo-grid-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: 
    linear-gradient(rgba(0, 243, 255, 0.1) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 243, 255, 0.1) 1px, transparent 1px);
  background-size: 30px 30px;
  z-index: 0;
  pointer-events: none;
}

/* 上下移动的激光扫描线 */
.holo-scanner {
  position: absolute;
  top: -10px;
  left: 0;
  width: 100%;
  height: 10px;
  background: var(--holo-cyan);
  box-shadow: 0 0 20px 5px var(--holo-cyan);
  opacity: 0.5;
  z-index: 10;
  pointer-events: none;
  animation: scan 4s linear infinite;
}

@keyframes scan {
  0% { transform: translateY(0); }
  100% { transform: translateY(560px); }
}

header {
  position: relative;
  z-index: 2;
  height: 50px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24px;
  border-bottom: 1px solid rgba(0, 243, 255, 0.3);
  background: linear-gradient(90deg, rgba(0,243,255,0.1), transparent);
  -webkit-app-region: drag;
}

.holo-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 700;
  font-size: 16px;
  letter-spacing: 2px;
  text-shadow: 0 0 8px var(--holo-cyan);
}

.holo-logo {
  width: 24px;
  height: 24px;
  filter: drop-shadow(0 0 5px var(--holo-cyan)) hue-rotate(180deg);
}

.holo-text-flicker {
  animation: flicker 3s infinite;
}
@keyframes flicker {
  0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% { opacity: 1; text-shadow: 0 0 8px var(--holo-cyan); }
  20%, 22%, 24%, 55% { opacity: 0.4; text-shadow: none; }
}

.holo-close {
  background: transparent;
  border: none;
  color: var(--holo-magenta);
  font-family: inherit;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  text-shadow: 0 0 5px var(--holo-magenta);
  -webkit-app-region: no-drag;
}
.holo-close:hover {
  text-shadow: 0 0 15px var(--holo-magenta);
}

main {
  position: relative;
  z-index: 2;
  flex: 1;
  padding: 40px;
  display: flex;
  flex-direction: column;
}

.holo-step {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.holo-center {
  justify-content: center;
  align-items: center;
}

.holo-anim-glitch {
  animation: holoGlitchIn 0.5s ease-out forwards;
}
@keyframes holoGlitchIn {
  0% { transform: scale(1.1) skewX(10deg); opacity: 0; filter: contrast(200%) hue-rotate(90deg); }
  50% { transform: scale(0.95) skewX(-5deg); opacity: 0.5; filter: contrast(150%) hue-rotate(-90deg); }
  100% { transform: scale(1) skewX(0); opacity: 1; filter: none; }
}

.holo-hero h1 {
  font-size: 32px;
  font-weight: 900;
  margin: 0 0 12px;
  text-shadow: 2px 2px 0 rgba(255,0,234,0.5), -2px -2px 0 rgba(0,243,255,0.5);
  letter-spacing: 4px;
}

.holo-hero p {
  font-size: 14px;
  color: rgba(0, 243, 255, 0.7);
  line-height: 1.6;
  margin: 0;
}

.holo-form {
  margin-top: auto;
}

.holo-form label {
  display: block;
  font-size: 12px;
  margin-bottom: 8px;
  letter-spacing: 2px;
  opacity: 0.8;
}

.holo-input-box {
  display: flex;
  align-items: center;
  background: rgba(0, 243, 255, 0.05);
  border: 1px solid var(--holo-cyan);
  padding: 6px;
  cursor: pointer;
  -webkit-app-region: no-drag;
  position: relative;
}
.holo-input-box::after {
  content: "";
  position: absolute;
  bottom: -1px; right: -1px;
  width: 10px; height: 10px;
  border-bottom: 2px solid var(--holo-cyan);
  border-right: 2px solid var(--holo-cyan);
}

.holo-input-box:hover {
  background: rgba(0, 243, 255, 0.15);
  box-shadow: 0 0 15px rgba(0, 243, 255, 0.2);
}

.holo-path {
  flex: 1;
  font-family: monospace;
  font-size: 14px;
  padding: 0 12px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.holo-btn-sm {
  background: transparent;
  color: var(--holo-cyan);
  border: 1px solid var(--holo-cyan);
  padding: 6px 16px;
  font-family: inherit;
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
}
.holo-btn-sm:hover {
  background: var(--holo-cyan);
  color: #000;
  box-shadow: 0 0 10px var(--holo-cyan);
}

/* 环形数据读取器 */
.holo-data-ring {
  position: relative;
  width: 180px;
  height: 180px;
  margin-bottom: 30px;
}

.holo-ring-outer {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 50%;
  border: 2px dashed rgba(0, 243, 255, 0.3);
  border-top: 4px solid var(--holo-cyan);
  border-left: 4px solid var(--holo-cyan);
  box-shadow: 0 0 20px rgba(0, 243, 255, 0.3);
  transition: transform 0.5s ease-out;
}

.holo-ring-inner {
  position: absolute;
  top: 15px; left: 15px; right: 15px; bottom: 15px;
  border-radius: 50%;
  border: 1px solid rgba(255, 0, 234, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle, rgba(0,243,255,0.1), transparent);
}

.holo-percent {
  font-size: 40px;
  font-weight: 900;
  text-shadow: 0 0 15px var(--holo-cyan);
}

.holo-status {
  font-size: 14px;
  letter-spacing: 2px;
  margin-bottom: 20px;
}
.holo-blink {
  animation: holoBlink 1s step-end infinite;
}
@keyframes holoBlink { 50% { opacity: 0; } }

.holo-data-stream {
  width: 200px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.holo-data-line {
  height: 2px;
  background: var(--holo-cyan);
  opacity: 0.5;
  animation: dataStream 0.5s linear infinite alternate;
}
@keyframes dataStream {
  0% { transform: scaleX(0.5); transform-origin: left; }
  100% { transform: scaleX(1); transform-origin: left; }
}

/* 成功特效 */
.holo-icon-success {
  color: #00ffcc;
  filter: drop-shadow(0 0 10px #00ffcc);
  margin-bottom: 20px;
}

.holo-modules {
  margin-top: 24px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.holo-module-item {
  background: rgba(0, 243, 255, 0.05);
  border-left: 3px solid var(--holo-cyan);
  padding: 8px 12px;
  font-size: 12px;
  letter-spacing: 1px;
}

/* Footer */
footer {
  position: relative;
  z-index: 2;
  padding: 20px 40px 30px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  -webkit-app-region: no-drag;
}

.holo-link {
  font-size: 12px;
  color: rgba(0, 243, 255, 0.5);
  text-decoration: none;
  letter-spacing: 1px;
}
.holo-link:hover {
  color: var(--holo-cyan);
  text-shadow: 0 0 5px var(--holo-cyan);
}

.holo-btn {
  background: rgba(0, 243, 255, 0.1);
  color: var(--holo-cyan);
  border: 1px solid var(--holo-cyan);
  padding: 12px 32px;
  font-family: inherit;
  font-size: 16px;
  font-weight: 900;
  letter-spacing: 2px;
  cursor: pointer;
  position: relative;
  text-shadow: 0 0 5px var(--holo-cyan);
  box-shadow: 0 0 15px rgba(0, 243, 255, 0.2);
  transition: all 0.2s;
}

.holo-btn-corner {
  position: absolute;
  top: -1px; left: -1px;
  width: 8px; height: 8px;
  background: var(--holo-cyan);
}

.holo-btn:hover {
  background: rgba(0, 243, 255, 0.3);
  box-shadow: 0 0 25px rgba(0, 243, 255, 0.5);
  transform: scale(1.02);
}

.holo-btn-full {
  width: 100%;
}
